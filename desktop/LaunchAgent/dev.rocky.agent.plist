<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>Label</key><string>dev.rocky.agent</string>
    <key>BundleProgram</key><string>Contents/Resources/runtime/bin/rocky-agent</string>
    <key>AssociatedBundleIdentifiers</key><array><string>dev.rocky.desktop</string></array>
    <key>RunAtLoad</key><true/>
    <!-- Restart after crashes; a clean exit (stopped by launchd) stays stopped. -->
    <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
    <key>ThrottleInterval</key><integer>10</integer>
    <key>ExitTimeOut</key><integer>20</integer>
    <key>ProcessType</key><string>Standard</string>
</dict></plist>
