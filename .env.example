# Reference only. Local CLI reads exported process environment, not this file.
# Docker Compose also supports an ignored .env file. Keep keys out of Git.
OPENAI_API_KEY=
ROCKY_MODEL=gpt-4.1-mini
ROCKY_API_TOKEN=
ROCKY_POSTGRES_PASSWORD=
ROCKY_TEMPORAL_ADDRESS=localhost:7233
ROCKY_DATABASE_URL=sqlite:///./data/rocky.db
ROCKY_WORKSPACE_ROOT=./data/workspaces
