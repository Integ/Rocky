# Reference only. Local CLI reads exported process environment, not this file.
# Docker Compose also supports an ignored .env file. Keep keys out of Git.
OPENAI_API_KEY=
ROCKY_MODEL=gpt-4.1-mini
# Optional with a reasoning model, e.g. ROCKY_MODEL=gpt-6-luna:
# ROCKY_REASONING_EFFORT=low
# Saved model settings override these initial defaults for new goals.
ROCKY_AUTH_MODE=local
# Optional for ROCKY_AUTH_MODE=token (Compose uses token mode explicitly).
ROCKY_API_TOKEN=
ROCKY_POSTGRES_PASSWORD=
ROCKY_TEMPORAL_ADDRESS=localhost:7233
ROCKY_DATABASE_URL=sqlite:///./data/rocky.db
ROCKY_WORKSPACE_ROOT=./data/workspaces
# Default: filesystem, all HTTP methods/sessions and shell commands as the current OS user.
ROCKY_TOOL_ACCESS=full
# Shell commands and HTTP writes require approval of the exact operation.
ROCKY_APPROVAL_MODE=required
# Simple commands (no ; && | > $ etc.) with these word prefixes run without approval.
# ROCKY_AUTO_APPROVE_COMMANDS=ls,pwd,git status,git diff,uv run pytest
# Explicit preauthorization for a trusted local agent: ROCKY_APPROVAL_MODE=trusted
# Optional legacy restricted mode for controlled deployments: ROCKY_TOOL_ACCESS=scoped

# Desktop configures provider keys in macOS Keychain through Settings.
# Other platforms store third-party keys in this private file (never commit it).
# ROCKY_CREDENTIAL_PATH=./data/credentials.json
