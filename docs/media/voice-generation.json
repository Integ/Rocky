      "sha256": "fff9632f8054ded657db755f3619b25c10c7020a9870e8e5a6b36e4ed9fe2ee7"
    },
    {
      "scene": 3,
      "text": "关上窗口，任务继续。重启之后，从检查点接着推进。",
      "seed": 20261104,
      "duration_seconds": 5.159042,
      "sha256": "e6f515863bbbfcfa05ba30b3902bd79a3595117c071ffff364db84bda625ddf2"
    },
    {
      "scene": 4,
      "text": "重要决定，由你掌握。批准操作，回答问题，在一处处理。",
      "seed": 20261105,
      "duration_seconds": 5.681708,
      "sha256": "5e1bdfc4028f71d0fa1ee16a10423b5d8956cd0f3e21b1f7b9bd8a82b9b72a25"
    },
    {
      "scene": 5,
      "text": "大目标，分步推进。定时和事件任务，按你的安排启动。",
      "seed": 20261106,
      "duration_seconds": 5.329708,
      "sha256": "b14c1735768065eaf74585ab473c71a1723a9f5507a8c041fcdc7d3bee29375f"
    },
    {
      "scene": 6,
      "text": "每轮交付，都有快照。接受结果，或在原任务上继续修改。",
      "seed": 20261107,
      "duration_seconds": 5.500375,
      "sha256": "d8a8c5ad855ebcfa1c728f368803fb741a353c34dc35c0210f74104293257cfa"
    },
    {
      "scene": 7,
      "text": "进度、预算与执行记录，随时可查。需要时，还能导出诊断包。",
      "seed": 20261108,
